<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Sandbox (required for Mac App Store) -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Outgoing network connections (model downloads, OpenRouter, Gemini APIs) -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Microphone access -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- Hardened Runtime: allow JIT (needed for whisper.cpp GGML operations) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Hardened Runtime: allow unsigned executable memory (needed for whisper-rs/GGML) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Hardened Runtime: disable library validation (needed for whisper.cpp native libs) -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Screen capture (for ScreenCaptureKit system audio recording) -->
    <!-- Note: This requires explicit user approval via TCC prompt -->
    <key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
    <array>
        <string>com.apple.screencapture.services</string>
    </array>
</dict>
</plist>
